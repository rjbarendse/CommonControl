# Voorbeeldinstellingen voor CommonControl. Kopieer naar .env en pas aan.

# ── Verplicht ────────────────────────────────────────────────────────────────
# Genereer een lange, willekeurige waarde, bijvoorbeeld met:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=vervang-dit-door-een-lange-willekeurige-waarde
ALLOWED_HOSTS=commoncontrol.gemeente.nl

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=db
DB_NAME=commoncontrol
DB_USER=commoncontrol
DB_PASSWORD=vervang-dit

# ── Eerste beheerder (alleen nodig bij de eerste start) ──────────────────────
ADMIN_GEBRUIKERSNAAM=beheerder
ADMIN_WACHTWOORD=een-lang-eerste-wachtwoord
ADMIN_EMAIL=beheer@gemeente.nl

# ── Optioneel ────────────────────────────────────────────────────────────────
# Aparte sleutel voor het versleutelen van opgeslagen API-secrets. Leeg laten
# mag; dan wordt hij afgeleid uit SECRET_KEY. Zet 'm expliciet als je SECRET_KEY
# ooit wilt kunnen vervangen zonder alle credentials opnieuw in te voeren.
# Genereer met:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Time-out in seconden op aanroepen naar de componenten.
# HTTP_TIMEOUT=20

# Alleen voor een testomgeving met een self-signed certificaat.
# VERIFY_TLS=true

# DEBUG=false
# LOG_LEVEL=INFO
